// Lifebit supplies executor, queue and workDir: none are set here.

params {
    collection    = null
    paths         = '/'
    outdir        = 'results'
    publish_mode  = 'copy'
    // change here, or with --globus_image, when a new image is built
    globus_image  = 'ghcr.io/nih-nlm/globus-download-nf/globus_tools:REPLACE_WITH_COMMIT_SHA'
    // The login (JSON from globus_login.py, or that JSON as base64).
    // On Lifebit: --parameter 'globus_tokens=${{globus_tokens}}' with a private variable of that name.
    globus_tokens = null
}

docker {
    enabled    = true
    runOptions = '--platform linux/amd64 --pull always'
}

process {
    withName: 'globus_list_process' {
        container = params.globus_image
        cpus      = 1
        memory    = '2 GB'
    }
    withName: 'globus_download_process' {
        container = params.globus_image
        cpus      = 1
        memory    = '2 GB'
    }
    withName: 'md5_verify_process' {
        container = params.globus_image
        cpus      = 1
        memory    = '4 GB'
    }
}
